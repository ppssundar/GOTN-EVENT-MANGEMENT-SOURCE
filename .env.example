# Copy to .env and fill in. With no Razorpay keys the app runs in DEMO payment mode;
# with no SMTP settings, emails are printed to the console instead of being sent.
PORT=3000
BASE_URL=http://localhost:3000
ADMIN_PASSWORD=change-me

# Razorpay (Dashboard > Settings > API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (any SMTP: Amazon SES, SendGrid, Gmail app password, Zoho...)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=EventDesk <no-reply@yourdomain.com>
